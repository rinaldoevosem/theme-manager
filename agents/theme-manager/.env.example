# Authentication: Uses your Claude subscription via Claude Code CLI.
# No API key needed — just run `claude` once to log in.

# Shopify store domain (e.g., your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Admin API access token
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

# GitHub personal access token (repo scope)
GITHUB_TOKEN=your_github_token

# GitHub organization or user that owns the theme repos
GITHUB_OWNER=your_github_org_or_user

# Theme repository names
GITHUB_REPO_MAIN=theme-main
GITHUB_REPO_STAGING=theme-staging
GITHUB_REPO_DEV=theme-dev

# Shopify Theme IDs (find in Shopify Admin → Online Store → Themes)
SHOPIFY_THEME_ID_MAIN=
SHOPIFY_THEME_ID_STAGING=
SHOPIFY_THEME_ID_DEV=

# Paperclip server URL (if using Paperclip orchestration)
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_AGENT_ID=theme-manager
